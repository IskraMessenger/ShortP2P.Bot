{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MessengerServer": {
    "BaseUrl": "https://127.0.0.1:51111",
    "AllowInvalidCertificate": true,
    "LongPollTimeoutSeconds": 25
  },
  "Bot": {
    "NetworkId": "MeteoBot00000001",
    "Name": "meteo_bot",
    "ReadableName": "Meteo",
    "Description": "Sample weather bot.",
    "IsMock": true
  },
  "Storage": {
    "ConnectionString": "Data Source=meteo-bot.db"
  },
  "Weather": {
    "Provider": "OpenMeteo",
    "BrightSkyBaseUrl": "https://api.brightsky.dev/",
    "OpenStreetMapBaseUrl": "https://nominatim.openstreetmap.org/"
  },
  "Voice": {
    "Format": "ogg",
    "BitRate": 64000
  }
}
